<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VELASCO COOP SAVINGS AND LOAN</title>

<!-- PWA Meta -->
<link rel="manifest" href="manifest.json">
<meta name="theme-color" content="#ff6b35">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#f5f5f5;
  --card:#ffffff;
  --text:#333;
  --subtext:#666;
  --primary:#ff6b35;
  --success:#28a745;
  --danger:#dc3545;
  --info:#007bff;
}
[data-theme="dark"]{
  --bg:#1a1a1a;
  --card:#2d2d2d;
  --text:#f5f5f5;
  --subtext:#aaa;
  --primary:#ff6b35;
  --success:#4caf50;
  --danger:#f44336;
  --info:#2196f3;
}
* {margin:0; padding:0; box-sizing:border-box; font-family:'Poppins', sans-serif;}
body {background:var(--bg); padding:16px; color:var(--text); transition:0.3s;}
h2 {color:var(--text); margin-bottom:12px; text-align:center;}
.card {
  background:var(--card);
  padding:14px;
  border-radius:10px;
  box-shadow:0 2px 6px rgba(0,0,0,0.08);
  margin-bottom:16px;
}
.total-box {
  background:var(--primary);
  color:white;
  padding:16px;
  border-radius:10px;
  text-align:center;
  font-size:18px;
  font-weight:700;
}
.member-list {display:grid; gap:10px;}
.member {
  background:var(--card);
  padding:12px;
  border-radius:10px;
  cursor:pointer;
  box-shadow:0 2px 5px rgba(0,0,0,0.06);
  position:relative;
}
.member-name {font-weight:600;}
.member-info {display:flex; justify-content:space-between; margin-top:6px; font-size:13px;}
.savings {color:var(--success); font-weight:700;}
.loan {color:var(--danger); font-weight:700;}
.btn-group {display:flex; gap:8px; flex-wrap:wrap;}
button {
  background:var(--primary);
  color:white;
  border:none;
  padding:10px 16px;
  border-radius:8px;
  font-weight:600;
  cursor:pointer;
  width:100%;
  margin-top:8px;
}
.btn-save {background:var(--success);}
.btn-loan {background:var(--danger);}
.btn-pay {background:var(--info);}
.btn-logout {background:#6c757d;}
.btn-delete {background:var(--danger); width:auto; padding:6px 10px; position:absolute; top:8px; right:8px;}
.btn-export {background:#17a2b8;}
.btn-change {background:#ffc107; color:#333;}
.btn-dark {background:#555;}
input, select {
  width:100%;
  padding:10px;
  border:1px solid #ddd;
  border-radius:8px;
  margin:6px 0;
  font-size:15px;
  background:var(--card);
  color:var(--text);
}
.modal {
  display:none;
  position:fixed;
  top:0; left:0; right:0; bottom:0;
  background:rgba(0,0,0,0.5);
  justify-content:center;
  align-items:center;
  z-index:100;
}
.modal-content {
  background:var(--card);
  padding:20px;
  border-radius:12px;
  width:90%;
  max-width:400px;
  max-height:80vh;
  overflow-y:auto;
}
.history-item {
  border-bottom:1px dashed #ddd;
  padding:8px 0;
  display:flex;
  justify-content:space-between;
  font-size:13px;
}
.receipt {
  background:#f0f0f0;
  padding:4px 8px;
  border-radius:4px;
  font-size:11px;
}
[data-theme="dark"].receipt {background:#444;}
.close {float:right; cursor:pointer; font-size:22px;}
.tab {display:flex; gap:8px; margin-bottom:12px;}
.tab button {background:#ddd; color:#333;}
.tab button.active {background:var(--primary); color:white;}
.empty {text-align:center; color:#999; padding:20px;}
.hidden {display:none!important;}
.admin-badge {
  background:var(--success);
  color:white;
  padding:4px 10px;
  border-radius:20px;
  font-size:12px;
  float:right;
}
.member-badge {
  background:var(--info);
  color:white;
  padding:4px 10px;
  border-radius:20px;
  font-size:12px;
  float:right;
}
.readonly {
  background:var(--bg);
  padding:10px;
  border-radius:8px;
  text-align:center;
  color:var(--subtext);
  font-size:13px;
}
.date-filter {display:flex; gap:8px; margin-bottom:10px;}
.date-filter input {flex:1;}
</style>
</head>
<body>

<div id="loginScreen">
  <h2>🏦 VELASCO COOP SAVINGS AND LOAN</h2>
  <div class="card">
    <h3>Login</h3>
    <input type="text" id="username" placeholder="Enter name or 'admin'">
    <input type="password" id="password" placeholder="Enter password">
    <button onclick="login()">Login</button>
    <button class="btn-dark" onclick="toggleTheme()">🌙 Toggle Dark Mode</button>
    <p style="font-size:12px; color:var(--subtext); margin-top:10px;">
      Admin: password <strong>velasco123</strong><br>
      Member: use your name as password
    </p>
  </div>
</div>

<div id="mainApp" class="hidden">
  <h2>🏦 VELASCO COOP SAVINGS AND LOAN <span id="userBadge"></span></h2>
  <div class="btn-group" id="adminButtons">
    <button class="btn-export" onclick="exportData()">Export/Share</button>
    <button class="btn-change" onclick="showChangePass()">Change Pass</button>
    <button class="btn-dark" onclick="toggleTheme()">🌙 Dark</button>
    <button class="btn-logout" onclick="logout()">Logout</button>
  </div>

  <div class="btn-group hidden" id="memberButtons">
    <button class="btn-dark" onclick="toggleTheme()">🌙 Dark</button>
    <button class="btn-logout" onclick="logout()">Logout</button>
  </div>

  <div class="card total-box" id="totalBox">
    Net Funds: ₱<span id="grandTotal">0</span><br>
    <small>Savings - Loans</small>
  </div>

  <div class="card" id="addMemberCard">
    <h3>Add Member</h3>
    <input type="text" id="newMember" placeholder="Enter member name">
    <button onclick="addMember()">Add Member</button>
  </div>

  <div class="search-box" id="searchBox">
    <input type="text" id="searchMember" placeholder="Search member..." oninput="renderMembers()">
  </div>

  <div class="member-list" id="memberList"></div>
</div>

<div class="modal" id="modal">
  <div class="modal-content">
    <span class="close" onclick="closeModal()">×</span>
    <h3 id="modalName"></h3>

    <div id="adminTabs" class="tab">
      <button id="tabSave" class="active" onclick="switchTab('save')">Hulog</button>
      <button id="tabLoan" onclick="switchTab('loan')">Utang</button>
      <button id="tabPay" onclick="switchTab('pay')">Bayad</button>
    </div>

    <div id="saveTab">
      <input type="number" id="saveAmount" placeholder="Enter amount">
      <input type="text" id="saveReceipt" placeholder="Receipt # (optional)">
      <button class="btn-save" onclick="addSaving()">Add Saving</button>
    </div>

    <div id="loanTab" style="display:none;">
      <input type="number" id="loanAmount" placeholder="Enter loan amount">
      <input type="text" id="loanReceipt" placeholder="Receipt # (optional)">
      <button class="btn-loan" onclick="addLoan()">Add Loan</button>
    </div>

    <div id="payTab" style="display:none;">
      <input type="number" id="payAmount" placeholder="Enter payment">
      <input type="text" id="payReceipt" placeholder="Receipt # (optional)">
      <button class="btn-pay" onclick="addPayment()">Pay Loan</button>
    </div>

    <div id="readonlyMsg" class="readonly hidden">
      Read-only mode. Contact admin to update your record.
    </div>

    <h4 style="margin-top:12px;">Filter by Date</h4>
    <div class="date-filter">
      <input type="date" id="dateFrom">
      <input type="date" id="dateTo">
      <button onclick="renderHistory()">Filter</button>
      <button onclick="clearFilter()">Clear</button>
    </div>

    <h4 style="margin-top:12px;">History</h4>
    <div id="historyList"></div>

    <h4 style="margin-top:12px;">
      Savings: ₱<span id="memberSave">0</span><br>
      Loan: ₱<span id="memberLoan">0</span><br>
      Balance: ₱<span id="memberBalance">0</span>
    </h4>
  </div>
</div>

<div class="modal" id="passModal">
  <div class="modal-content">
    <span class="close" onclick="closePassModal()">×</span>
    <h3>Change Password</h3>
    <input type="password" id="oldPass" placeholder="Old password">
    <input type="password" id="newPass" placeholder="New password">
    <input type="password" id="confirmPass" placeholder="Confirm password">
    <button onclick="changePassword()">Update Password</button>
  </div>
</div>

<script>
let currentMember = '';
let currentUser = '';
let userRole = '';
let ADMIN_PASSWORD = localStorage.getItem('velascoPass') || 'velasco123';

// PWA Service Worker Register
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('./sw.js');
}

// Dark Mode Toggle
function toggleTheme(){
  let theme = document.documentElement.getAttribute('data-theme');
  if(theme === 'dark'){
    document.documentElement.removeAttribute('data-theme');
    localStorage.setItem('theme','light');
  } else {
    document.documentElement.setAttribute('data-theme','dark');
    localStorage.setItem('theme','dark');
  }
}
if(localStorage.getItem('theme')==='dark'){
  document.documentElement.setAttribute('data-theme','dark');
}

function checkLogin() {
  let user = sessionStorage.getItem('velascoUser');
  let role = sessionStorage.getItem('velascoRole');
  if (user && role) {
    currentUser = user;
    userRole = role;
    document.getElementById('loginScreen').classList.add('hidden');
    document.getElementById('mainApp').classList.remove('hidden');

    if (role === 'admin') {
      document.getElementById('userBadge').innerHTML = '<span class="admin-badge">ADMIN</span>';
      document.getElementById('adminButtons').classList.remove('hidden');
      document.getElementById('memberButtons').classList.add('hidden');
    } else {
      document.getElementById('userBadge').innerHTML = '<span class="member-badge">MEMBER</span>';
      document.getElementById('adminButtons').classList.add('hidden');
      document.getElementById('memberButtons').classList.remove('hidden');
      document.getElementById('addMemberCard').classList.add('hidden');
      document.getElementById('searchBox').classList.add('hidden');
      document.getElementById('totalBox').classList.add('hidden');
      openMember(user);
    }
    renderMembers();
  }
}

function login() {
  let username = document.getElementById('username').value.trim();
  let password = document.getElementById('password').value;
  if (!username ||!password) return alert('Enter username and password!');

  if (username.toLowerCase() === 'admin' && password === ADMIN_PASSWORD) {
    sessionStorage.setItem('velascoUser', 'admin');
    sessionStorage.setItem('velascoRole', 'admin');
    checkLogin();
  } else {
    let data = loadData();
    if (data.members[username] && password === username) {
      sessionStorage.setItem('velascoUser', username);
      sessionStorage.setItem('velascoRole', 'member');
      checkLogin();
    } else {
      alert('Invalid credentials!');
    }
  }
}

function logout() {
  sessionStorage.removeItem('velascoUser');
  sessionStorage.removeItem('velascoRole');
  location.reload();
}

function loadData() {
  return JSON.parse(localStorage.getItem('velascoCoopData') || '{"members":{}}');
}

function saveData(data) {
  localStorage.setItem('velascoCoopData', JSON.stringify(data));
}

function addMember() {
  if (userRole!== 'admin') return;
  let name = document.getElementById('newMember').value.trim();
  if (!name) return alert('Enter name!');
  let data = loadData();
  if(data.members[name]) return alert('Member already exists!');
  data.members[name] = {savings: [], loans: [], payments: []};
  saveData(data);
  document.getElementById('newMember').value = '';
  renderMembers();
}

function deleteMember(name) {
  if (userRole!== 'admin') return;
  if (!confirm('Delete member ' + name + '?')) return;
  let data = loadData();
  delete data.members[name];
  saveData(data);
  renderMembers();
}

function renderMembers() {
  let data = loadData();
  let list = document.getElementById('memberList');
  let search = document.getElementById('searchMember')?.value.toLowerCase() || '';
  list.innerHTML = '';
  let netTotal = 0;
  let memberNames = Object.keys(data.members).filter(n => n.toLowerCase().includes(search));

  if (memberNames.length === 0) {
    list.innerHTML = '<div class="empty">No members found</div>';
    if (document.getElementById('grandTotal')) document.getElementById('grandTotal').textContent = 0;
    return;
  }

  for (let name of memberNames) {
    let m = data.members[name];
    let saveTotal = (m.savings || []).reduce((sum, h) => sum + h.amount, 0);
    let loanTotal = (m.loans || []).reduce((sum, h) => sum + h.amount, 0);
    let payTotal = (m.payments || []).reduce((sum, h) => sum + h.amount, 0);
    let balance = saveTotal - (loanTotal - payTotal);
    netTotal += balance;
    let deleteBtn = userRole === 'admin'? `<button class="btn-delete" onclick="event.stopPropagation(); deleteMember('${name}')">×</button>` : '';
    list.innerHTML += `<div class="member" onclick="openMember('${name}')">${deleteBtn}<div class="member-name">${name}</div><div class="member-info"><span class="savings">Save: ₱${saveTotal}</span><span class="loan">Loan: ₱${loanTotal - payTotal}</span><span>Balance: ₱${balance}</span></div></div>`;
  }
  if (document.getElementById('grandTotal')) document.getElementById('grandTotal').textContent = netTotal;
}

function openMember(name) {
  if (userRole === 'member' && name!== currentUser) return;
  currentMember = name;
  document.getElementById('modalName').textContent = name;
  document.getElementById('modal').style.display = 'flex';
  if (userRole === 'admin') {
    document.getElementById('adminTabs').classList.remove('hidden');
    document.getElementById('readonlyMsg').classList.add('hidden');
  } else {
    document.getElementById('adminTabs').classList.add('hidden');
    document.getElementById('readonlyMsg').classList.remove('hidden');
  }
  clearFilter();
  renderHistory();
}

function switchTab(tab) {
  if (userRole!== 'admin') return;
  document.getElementById('tabSave').classList.remove('active');
  document.getElementById('tabLoan').classList.remove('active');
  document.getElementById('tabPay').classList.remove('active');
  document.getElementById('saveTab').style.display = 'none';
  document.getElementById('loanTab').style.display = 'none';
  document.getElementById('payTab').style.display = 'none';
  document.getElementById('tab' + tab.charAt(0).toUpperCase() + tab.slice(1)).classList.add('active');
  document.getElementById(tab + 'Tab').style.display = 'block';
}

function addSaving() {
  if (userRole!== 'admin') return;
  let amount = parseFloat(document.getElementById('saveAmount').value);
  let receipt = document.getElementById('saveReceipt').value;
  if (!amount || amount <= 0) return alert('Enter valid amount!');
  let data = loadData();
  data.members[currentMember].savings.push({amount, receipt, date: new Date().toISOString()});
  saveData(data);
  document.getElementById('saveAmount').value = '';
  document.getElementById('saveReceipt').value = '';
  renderHistory(); renderMembers();
}

function addLoan() {
  if (userRole!== 'admin') return;
  let amount = parseFloat(document.getElementById('loanAmount').value);
  let receipt = document.getElementById('loanReceipt').value;
  if (!amount || amount <= 0) return alert('Enter valid amount!');
  let data = loadData();
  data.members[currentMember].loans.push({amount, receipt, date: new Date().toISOString()});
  saveData(data);
  document.getElementById('loanAmount').value = '';
  document.getElementById('loanReceipt').value = '';
  renderHistory(); renderMembers();
}

function addPayment() {
  if (userRole!== 'admin') return;
  let amount = parseFloat(document.getElementById('payAmount').value);
  let receipt = document.getElementById('payReceipt').value;
  if (!amount || amount <= 0) return alert('Enter valid amount!');
  let data = loadData();
  let m = data.members[currentMember];
  let loanTotal = (m.loans || []).reduce((sum, h) => sum + h.amount, 0);
  let payTotal = (m.payments || []).reduce((sum, h) => sum + h.amount, 0);
  if (amount > loanTotal - payTotal) return alert('Payment exceeds loan amount!');
  data.members[currentMember].payments.push({amount, receipt, date: new Date().toISOString()});
  saveData(data);
  document.getElementById('payAmount').value = '';
  document.getElementById('payReceipt').value = '';
  renderHistory(); renderMembers();
}

function clearFilter(){
  document.getElementById('dateFrom').value = '';
  document.getElementById('dateTo').value = '';
  renderHistory();
}

function renderHistory() {
  let data = loadData();
  let m = data.members[currentMember];
  let from = document.getElementById('dateFrom').value;
  let to = document.getElementById('dateTo').value;

  let allHistory = [
   ...(m.savings || []).map(h => ({...h, type:'Saving'})),
   ...(m.loans || []).map(h => ({...h, type:'Loan'})),
   ...(m.payments || []).map(h => ({...h, type:'Payment'}))
  ].filter(h=>{
    let d = h.date.split('T')[0];
    if(from && d < from) return false;
    if(to && d > to) return false;
    return true;
  }).sort((a, b) => new Date(b.date) - new Date(a.date));

  let saveTotal = (m.savings || []).reduce((sum, h) => sum + h.amount, 0);
  let loanTotal = (m.loans || []).reduce((sum, h) => sum + h.amount, 0);
  let payTotal = (m.payments || []).reduce((sum, h) => sum + h.amount, 0);

  let historyHTML = '';
  allHistory.forEach(h => {
    let color = h.type == 'Saving'? 'var(--success)' : h.type == 'Loan'? 'var(--danger)' : 'var(--info)';
    let dateStr = new Date(h.date).toLocaleDateString();
    let receiptStr = h.receipt? `<span class="receipt">RC#: ${h.receipt}</span>` : '';
    historyHTML += `<div class="history-item" style="color:${color}">
      <div><span>${dateStr} - ${h.type}</span> ${receiptStr}</div>
      <span>₱${h.amount}</span>
    </div>`;
  });

  document.getElementById('historyList').innerHTML = historyHTML || '<div>No transactions yet</div>';
  document.getElementById('memberSave').textContent = saveTotal;
  document.getElementById('memberLoan').textContent = loanTotal - payTotal;
  document.getElementById('memberBalance').textContent = saveTotal - (loanTotal - payTotal);
}

function exportData() {
  if (userRole!== 'admin') return;
  let data = loadData();
  let text = 'VELASCO COOP SAVINGS AND LOAN\n';
  text += 'Generated: ' + new Date().toLocaleString() + '\n\n';
  for (let name in data.members) {
    let m = data.members[name];
    let saveTotal = (m.savings || []).reduce((sum, h) => sum + h.amount, 0);
    let loanTotal = (m.loans || []).reduce((sum, h) => sum + h.amount, 0);
    let payTotal = (m.payments || []).reduce((sum, h) => sum + h.amount, 0);
    let balance = saveTotal - (loanTotal - payTotal);
    text += `${name}\n Savings: ₱${saveTotal}\n Loan: ₱${loanTotal - payTotal}\n Balance: ₱${balance}\n\n`;
  }
  navigator.clipboard.writeText(text).then(() => alert('Copied to clipboard!'));
}

function showChangePass() { document.getElementById('passModal').style.display = 'flex'; }
function closePassModal() { document.getElementById('passModal').style.display = 'none'; }

function changePassword() {
  let oldPass = document.getElementById('oldPass').value;
  let newPass = document.getElementById('newPass').value;
  let confirmPass = document.getElementById('confirmPass').value;
  if (oldPass!== ADMIN_PASSWORD) return alert('Wrong old password!');
  if (newPass!== confirmPass) return alert('Passwords do not match!');
  if (newPass.length < 4) return alert('Password must be at least 4 characters!');
  ADMIN_PASSWORD = newPass;
  localStorage.setItem('velascoPass', newPass);
  alert('Password changed successfully!');
  closePassModal();
  document.getElementById('oldPass').value = '';
  document.getElementById('newPass').value = '';
  document.getElementById('confirmPass').value = '';
}

function closeModal() {
function closeModal() {
  document.getElementById('modal').style.display = 'none';
}

function closePassModal() {
  document.getElementById('passModal').style.display = 'none';
}

window.onclick = function(e) {
  if (e.target.id == 'modal') closeModal();
  if (e.target.id == 'passModal') closePassModal();
}

checkLogin();

// PWA Service Worker Registration - idagdag mo to sa pinakadulo
if ('serviceWorker' in navigator) {
  navigator.serviceWorker.register('./sw.js');
}
</script>
</body>
</html>
